# Public Firebase Web SDK configuration for ReturnBond Website Ratings, Reviews & Private Feedback
# Existing Firebase Project ID: returnbond-7c6ae
#
# Copy these values from:
#   Firebase Console -> Project Settings (returnbond-7c6ae) -> General -> Your apps -> Web app
#
# SECURITY NOTE:
# Only public Firebase Web SDK configuration belongs in VITE_* variables.
# NEVER place Firebase Admin SDK service-account keys or private secrets in frontend code or VITE_* variables.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=returnbond-7c6ae.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=returnbond-7c6ae
VITE_FIREBASE_STORAGE_BUCKET=returnbond-7c6ae.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Leave blank to use the existing "(default)" Cloud Firestore database in returnbond-7c6ae
VITE_FIREBASE_DATABASE_ID=

# Optional: Public reCAPTCHA v3 Site Key to activate Firebase App Check spam protection on the website
VITE_FIREBASE_RECAPTCHA_SITE_KEY=
